#!/bin/sh
# claude-sessions installer — usage: curl -fsSL amirbaer.github.io/tikunolam/cs | sh
# Source: https://github.com/amirbaer/pichefkes (claude/claude-sessions.py)
set -e
mkdir -p "$HOME/.local/bin"
curl -fsSL https://raw.githubusercontent.com/amirbaer/pichefkes/master/claude/claude-sessions.py -o "$HOME/.local/bin/claude-sessions"
chmod +x "$HOME/.local/bin/claude-sessions"
echo "claude-sessions installed to ~/.local/bin/claude-sessions"
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) echo 'NOTE: ~/.local/bin is not on your PATH. Add this to your shell rc:'
       echo '  export PATH="$HOME/.local/bin:$PATH"' ;;
esac

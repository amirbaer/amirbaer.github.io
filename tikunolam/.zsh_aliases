# ~/.zsh_aliases — zsh-native equivalents of ~/.bash_aliases

# Tools (claude, codex, cswap, uv) install into ~/.local/bin
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

export PAGER="less -R"
export EDITOR="vim"

# EDITOR=vim makes zsh default to the vi keymap on the command line, where
# ^P/^N/^R don't navigate history. Use emacs line editing instead — gives the
# whole set (^P/^N, ^R, ^A/^E/^K/^W, ...). Only affects the command line, not
# $EDITOR. Ctrl+S forward-search needs flow control (XOFF) off to reach zsh.
bindkey -e
[[ -o interactive ]] && stty -ixon 2>/dev/null

# Word-motion/kill bindings (zsh equivalents of ~/.inputrc, which zsh ignores).
bindkey '^W' backward-kill-word
bindkey '^G' kill-word
bindkey '^Y' backward-word
bindkey '^J' forward-word

# History
export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE="$HOME/.zsh_history"
setopt APPEND_HISTORY
setopt HIST_IGNORE_DUPS

# Colors (BSD/macOS ls via CLICOLOR; GNU/Linux ls via --color)
export CLICOLOR=1
export LSCOLORS="Exgxcxdxcxegedabagacad"
if ls --color=auto >/dev/null 2>&1; then
    alias ls='ls --color=auto'
fi

# Prompt with git branch (zsh equivalent of the bash PS1)
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats ' (%b)'
precmd() { vcs_info }
setopt PROMPT_SUBST
PROMPT='%F{green}[%f %n@%m:%F{blue}%~%F{yellow}${vcs_info_msg_0_}%f %F{green}]%f '

alias less="less -R"
alias jq="jq -C"
jctl()   { cat "$1" | jq | less ; }
jctlip() { local tmp=$(mktemp) && sed 's/\x1b\[[0-9;]*m//g' "$1" | command jq . > "$tmp" && mv "$tmp" "$1"; }
mem()    { ps -eo rss,pid,euser,args:100 --sort %mem | grep -v grep | grep -i "$@" | awk '{printf $1/1024 "MB"; $1=""; print }'; }

# Start tmux and restore the last saved sessions (tmux-resurrect) if the server
# isn't already running -- e.g. after a reboot. Attaches when done.
tmux-start() {
  if tmux has-session 2>/dev/null; then
    tmux attach "$@"
    return
  fi
  local restore="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
  if [ ! -x "$restore" ]; then
    tmux new-session "$@"
    return
  fi
  tmux new-session -d -s _boot            # holder keeps the server alive during restore
  # run-shell, not a direct call: restore.sh derives the socket from $TMUX, which is
  # empty outside tmux, so calling it directly creates NO sessions (one "error
  # creating  (No such file or directory)" per session, then a cascade of "can't
  # find window" for every pane) and only the holder survives. run-shell runs it
  # inside the server with $TMUX set and blocks until it finishes; this is how
  # resurrect's own prefix + C-r binding invokes it.
  tmux run-shell "$restore"
  # drop the holder if real sessions came back
  if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qv '^_boot$'; then
    tmux kill-session -t _boot 2>/dev/null
  else
    echo "tmux-start: restore brought back no sessions; snapshots are intact in ~/.local/share/tmux/resurrect" >&2
  fi
  tmux attach "$@"
}
